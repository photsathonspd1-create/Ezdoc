generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                  String        @id @default(cuid())
  supabaseId          String        @unique @map("supabase_id")
  email               String        @unique
  name                String
  avatarUrl           String?       @map("avatar_url")
  phone               String?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  lineUserId          String?       @unique @map("line_user_id")
  createdDocuments    Document[]
  memberships         OrgMember[]
  assignedTasks       Task[]
  createdTransactions Transaction[]

  @@map("users")
}

model Organization {
  id              String        @id @default(cuid())
  name            String
  taxId           String?       @map("tax_id")
  address         String?
  logoUrl         String?       @map("logo_url")
  phone           String?
  email           String?
  website         String?
  planTier        String        @default("FREE") @map("plan_tier")
  openaiKey       String?       @map("openai_key")
  lineToken       String?       @map("line_token")
  defaultVatRate  Float         @default(7)                  @map("default_vat_rate")
  defaultWhtRate  Float         @default(0)                  @map("default_wht_rate")
  budgetRevenue   Float         @default(0)                  @map("budget_revenue")
  budgetExpense   Float         @default(0)                  @map("budget_expense")
  fiscalYearStart Int           @default(1)                  @map("fiscal_year_start")
  stampUrl        String?                                    @map("stamp_url")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  aiInsights      AiInsight[]
  categories      Category[]
  contacts        Contact[]
  documents       Document[]
  members         OrgMember[]
  projects        Project[]
  tasks           Task[]
  transactions    Transaction[]
  auditLogs       AuditLog[]
  chatSessions    ChatSession[]

  @@map("organizations")
}

model AuditLog {
  id        String       @id @default(cuid())
  orgId     String       @map("org_id")
  userId    String?      @map("user_id")
  action    String
  resource  String
  details   String?
  ipAddress String?      @map("ip_address")
  createdAt DateTime     @default(now()) @map("created_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}

model OrgMember {
  id       String       @id @default(cuid())
  orgId    String       @map("org_id")
  userId   String       @map("user_id")
  role     String       @default("MEMBER")
  joinedAt DateTime     @default(now()) @map("joined_at")
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, userId])
  @@map("org_members")
}

model Contact {
  id         String       @id @default(cuid())
  orgId      String       @map("org_id")
  name       String
  type       String       @default("COMPANY")
  taxId      String?      @map("tax_id")
  address    String?
  email      String?
  phone      String?
  lineUserId String?      @map("line_user_id")
  notes      String?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  documents  Document[]
  projects   Project[]

  @@map("contacts")
}

model Category {
  id           String        @id @default(cuid())
  orgId        String        @map("org_id")
  name         String
  type         String
  color        String        @default("#6366f1")
  icon         String        @default("tag")
  isDefault    Boolean       @default(false) @map("is_default")
  createdAt    DateTime      @default(now()) @map("created_at")
  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("categories")
}

model Transaction {
  id               String       @id @default(cuid())
  orgId            String       @map("org_id")
  type             String
  amount           Float
  vatRate          Float        @default(7) @map("vat_rate")
  vatAmount        Float        @default(0) @map("vat_amount")
  amountExVat      Float        @default(0) @map("amount_ex_vat")
  vendorName       String?
  vendorTaxId      String?
  vendorBranch     String?      @default("00000")
  vendorAddress    String?
  isTaxInvoice     Boolean      @default(false)
  taxInvoiceNumber String?
  taxInvoiceDate   DateTime?
  whtRate          Float?       @default(0)
  whtAmount        Float?       @default(0)
  internalRef      String?
  department       String?
  description      String
  categoryId       String?      @map("category_id")
  date             DateTime
  paymentMethod    String?      @map("payment_method")
  status           String       @default("COMPLETED")
  receiptUrl       String?      @map("receipt_url")
  documentId       String?      @map("document_id")
  projectId        String?      @map("project_id")
  createdById      String       @map("created_by_id")
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  org              Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy        User         @relation(fields: [createdById], references: [id])
  category         Category?    @relation(fields: [categoryId], references: [id])

  @@index([orgId, date])
  @@index([orgId, type])
  @@map("transactions")
}

model Project {
  id            String       @id @default(cuid())
  orgId         String       @map("org_id")
  name          String
  clientId      String?      @map("client_id")
  status        String       @default("PENDING")
  budget        Float?
  paidAmount    Float        @default(0) @map("paid_amount")
  paymentStatus String       @default("UNPAID") @map("payment_status")
  startDate     DateTime?    @map("start_date")
  dueDate       DateTime?    @map("due_date")
  tags          String       @default("[]")
  notes         String?
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  documents     Document[]
  org           Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  client        Contact?     @relation(fields: [clientId], references: [id])
  tasks         Task[]

  @@index([orgId, status])
  @@index([orgId, dueDate])
  @@map("projects")
}

model Document {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  projectId   String?      @map("project_id")
  clientId    String?      @map("client_id")
  type        String
  docNumber   String       @map("doc_number")
  status      String       @default("DRAFT")
  issuedDate  DateTime     @map("issued_date")
  dueDate     DateTime?    @map("due_date")
  items       String       @default("[]")
  subtotal    Float
  vatAmount   Float        @default(0) @map("vat_amount")
  total       Float
  pdfUrl      String?      @map("pdf_url")
  notes       String?
  createdById String       @map("created_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  project     Project?     @relation(fields: [projectId], references: [id])
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdBy   User         @relation(fields: [createdById], references: [id])
  client      Contact?     @relation(fields: [clientId], references: [id])

  @@unique([orgId, docNumber])
  @@index([orgId, type])
  @@map("documents")
}

model Task {
  id          String       @id @default(cuid())
  orgId       String       @map("org_id")
  projectId   String?      @map("project_id")
  title       String
  description String?
  assigneeId  String?      @map("assignee_id")
  dueDate     DateTime?    @map("due_date")
  status      String       @default("PENDING")
  priority    String       @default("MEDIUM")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  project     Project?     @relation(fields: [projectId], references: [id])
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  assignee    User?        @relation(fields: [assigneeId], references: [id])

  @@map("tasks")
}

model AiInsight {
  id        String       @id @default(cuid())
  orgId     String       @map("org_id")
  type      String
  title     String
  content   String
  metadata  String?
  isRead    Boolean      @default(false) @map("is_read")
  createdAt DateTime     @default(now()) @map("created_at")
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("ai_insights")
}

model ChatSession {
  id        String        @id @default(cuid())
  orgId     String        @map("org_id")
  title     String        @default("New Conversation")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  messages  ChatMessage[]
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  role      String
  content   String
  metadata  String?
  createdAt DateTime    @default(now()) @map("created_at")
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@map("chat_messages")
}
